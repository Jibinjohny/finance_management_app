{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CashFlow (Debug Mode)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart"
        },
        {
            "name": "CashFlow (macOS Desktop)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "macos"
        },
        {
            "name": "CashFlow (Chrome Web)",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "chrome"
        },
        {
            "name": "CashFlow (Profile Mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile",
            "program": "lib/main.dart",
            "args": ["--no-tree-shake-icons"]
        },
        {
            "name": "CashFlow (Release Mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "program": "lib/main.dart",
            "args": ["--no-tree-shake-icons"]
        },
        {
            "name": "CashFlow (All Tests)",
            "request": "launch",
            "type": "dart",
            "program": "test/"
        }
    ]
}